{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/chat", "destination": "/api/index.py" },
    { "source": "/match-jd", "destination": "/api/index.py" },
    { "source": "/", "destination": "/src/frontend/index.html" },
    { "source": "/(.*)", "destination": "/src/frontend/$1" }
  ]
}